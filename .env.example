# ── Instance identity ──────────────────────────────────────────────────
# Copy this file to .env and change the values for a new instance.
INSTANCE_NAME=iНюша
INSTANCE_SLUG=inysha
AGENT_NAME=DELIRIA
AGENT_DISPLAY_NAME=Deliria
AGENT_PERSONA_NAME=Делирия Фора
HELPER_NAME=HELPER
SERVER_TITLE=iNysha Cloud

# ── Public routes / secrets ────────────────────────────────────────────
# INSTANCE_SLUG derives the default webhook path: /<slug>/max-webhook.
# Set MAX_WEBHOOK_PATH explicitly to override it.
# MAX_WEBHOOK_PATH=/inysha/max-webhook
# Short legacy alias; set empty to disable.
MAX_WEBHOOK_ALIAS_PATH=/max-webhook
SECRET_HEADER=X-Inysha-Secret

# ── Paths ──────────────────────────────────────────────────────────────
# Relative paths are resolved against the checkout root.
# DATA_DIR=./data
# DOWNLOADS_DIR=./data/downloads
# SCREENSHOTS_DIR=./data/screenshots
# LOG_FILE=./data/agent.log
# TTS_CACHE_DIR=./data/tts_cache
# SCHEDULER_TASKS_FILE=./data/scheduler_tasks.json
# MAX_MARKER_FILE=./data/max_marker.json
# MEMORY_DB_PATH=./data/memory.db
# STATIC_DIR=./static
# VOICE_STATIC_DIR=./static/voice
# PROMPTS_DIR=./system_prompts

# ── Long-term memory ───────────────────────────────────────────────────
# json   — persistent_memory.json целиком (текущее поведение, по умолчанию);
# sqlite — плюс релевантный блок из memory.db (~400 токенов на ход), вставленный
#          в хвост промпта один раз за ход и учтённый в overflow-accounting.
MEMORY_BACKEND=json
# Жёсткий лимит блока памяти в токенах (не в байтах).
MEMORY_BLOCK_TOKENS=400
MEMORY_BLOCK_MAX_ITEMS=8
MEMORY_ITEM_TOKENS=60
# Отдельный лог памяти: сюда попадают только server.memory* (DEBUG по умолчанию).
# MEMORY_LOG_FILE=./data/memory.log
# Полный текст блока — на TRACE; в agent.log он не попадает.
# MEMORY_LOG_LEVEL=TRACE
# Эпизоды (поисковый транскрипт) пишутся из того же хука, что message_history.md.
# MEMORY_WRITE_EPISODES=1
# Результаты инструментов в эпизоды не пишем: они огромны и есть в истории.
# MEMORY_EPISODE_TOOLS=0

# Факты из файлов и страниц: ссылаться можно только на прочитанное за это окно,
# а внешние строки в блоке имеют отдельную квоту.
# MEMORY_SOURCE_WINDOW_DAYS=7
# MEMORY_BLOCK_EXTERNAL_ITEMS=3

# Фоновый экстрактор фактов: свой таймер, свой LLM-клиент, только кандидаты
# в pending_facts. По умолчанию выключен — он тратит токены.
# MEMORY_EXTRACTOR=0
# MEMORY_EXTRACT_INTERVAL=120
# MEMORY_EXTRACT_BATCH=12
# MEMORY_EXTRACT_MIN_CHARS=40

# ── Server ─────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8010
LOG_LEVEL=INFO

# ── LLM / search ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_HELPER=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_MAX_OUTPUT_TOKENS=30000
TAVILY_API_KEY=

# ── MAX ────────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_TRANSPORT=poll
# MAX_REASONING_CHAT_ID=
# MAX_SEND_REASONING=0
# MAX_DEFER_SECONDS=6.0
# MAX_BATCH_MESSAGES=10
# MAX_BATCH_CHARS=4000
# MAX_CONCURRENT_UPDATES=5
# MAX_CHAT_RATE_LIMIT=10
# MAX_CHAT_RATE_WINDOW=60
# MAX_AUDIO_MAX_BYTES=25165824
# MAX_ATTACHMENT_MAX_BYTES=67108864
# Comma-separated ids. Empty means no trusted MAX sources.
TRUSTED_MAX_CHAT_IDS=
TRUSTED_MAX_USER_IDS=

# ── Desktop clients ────────────────────────────────────────────────────
CLIENT_TOKEN=
CLIENT_TRUSTED=1

# ── Voice / TTS / STT ──────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=ru
VOICE_SAMPLE_RATE=16000
VOICE_TURN_TIMEOUT=180
VOICE_MAX_SECONDS=20
VOICE_TTS_FORMAT=pcm_16000
VOICE_TTS_LATENCY=3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_MAX_CHARS=4000
TTS_SPEED=1.2
