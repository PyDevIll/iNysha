# Desktop client configuration.
# Copy this file to .env next to the client (or export the variables).

# Plain HTTP WebSocket endpoint of the VDS (no TLS / nginx required).
SERVER_URL=ws://2.24.160.163:8010

# Must match CLIENT_TOKEN in the server's .env. Do not reuse MAX_WEBHOOK_SECRET.
CLIENT_TOKEN=replace-with-the-server-client-token

# Stable id used by the agent for routing (letters, digits, _ . -).
CLIENT_ID=desktop-andrey
CLIENT_NAME=Andrey desktop

# Global hotkey. Use "<f8>", "<ctrl>+<alt>+space", etc.
# On Ubuntu Wayland, global grabs may be blocked; use the console command "v".
CLIENT_HOTKEY=<f8>

# Start a voice session automatically on launch.
CLIENT_AUTO_START=0

# Optional: numeric device index or a name substring.
# CLIENT_INPUT_DEVICE=0
# CLIENT_OUTPUT_DEVICE=0
